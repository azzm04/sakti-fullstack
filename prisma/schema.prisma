generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── WHITELIST SSO ────────────────────────────────────────
// Diisi oleh Admin via upload Excel
model SsoWhitelist {
  id           String   @id @default(cuid())
  email        String   @unique
  nama         String
  role         Role     @default(MAHASISWA_KIPK)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?

  @@map("sso_whitelist")
}

// ─── USER ─────────────────────────────────────────────────
// Dibuat otomatis saat mahasiswa pertama kali login OTP
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  nama        String
  nim         String?      @unique
  prodi       String?
  fakultas    String?
  role        Role
  telegramId  String?      @unique
  whitelistId String       @unique
  whitelist   SsoWhitelist @relation(fields: [whitelistId], references: [id])
  otpTokens   OtpToken[]
  chatHistory ChatHistory[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}

// ─── OTP TOKEN ────────────────────────────────────────────
model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String   // bcrypt hashed
  expiresAt DateTime // 5 menit dari createdAt
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_tokens")
}

// ─── ADMIN DIRMAWA ────────────────────────────────────────
// Login pakai adminId + password, bukan OTP
model AdminUser {
  id        String   @id @default(cuid())
  adminId   String   @unique
  password  String   // bcrypt hashed
  nama      String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

// ─── CHAT HISTORY ─────────────────────────────────────────
model ChatHistory {
  id        String   @id @default(cuid())
  userId    String?  // null = pengguna umum
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  imageUrl  String?
  createdAt DateTime @default(now())

  @@map("chat_history")
}

// ─── MONEV SCHEDULE ───────────────────────────────────────
model MonevSchedule {
  id        String   @id @default(cuid())
  label     String
  deadline  DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationLogs NotificationLog[]

  @@map("monev_schedules")
}

// ─── NOTIFICATION LOG ─────────────────────────────────────
model NotificationLog {
  id              String        @id @default(cuid())
  monevScheduleId String
  monevSchedule   MonevSchedule @relation(fields: [monevScheduleId], references: [id])
  triggerDay      Int
  totalSent       Int           @default(0)
  totalFailed     Int           @default(0)
  sentAt          DateTime      @default(now())

  @@map("notification_logs")
}

// ─── ENUM ROLE ────────────────────────────────────────────
enum Role {
  MAHASISWA_KIPK
  PEWAWANCARA
  ADMIN_DIRMAWA
}

// ─── PEWAWANCARA ──────────────────────────────────────────
// Tabel pewawancara terpisah (dari skenario BAB 2.5)
// Berbeda dengan User — pewawancara punya blok penugasan
model Pewawancara {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique
  nama            String?
  ssoId           String?   @map("sso_id")
  blokPenugasan   Int?      @map("blok_penugasan")
  totalAssigned   Int       @default(0) @map("total_assigned")
  totalCompleted  Int       @default(0) @map("total_completed")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  assignments     WawancaraAssignment[]

  @@map("pewawancara")
}

// ─── WAWANCARA ASSIGNMENT ─────────────────────────────────
// Relasi kandidat ↔ pewawancara
model WawancaraAssignment {
  id             BigInt    @id @default(autoincrement())
  kandidatId     BigInt    @map("kandidat_id")
  pewawancaraId  BigInt    @map("pewawancara_id")
  blok           Int?
  status         String    @default("pending") // pending | completed | cancelled
  scheduledAt    DateTime? @map("scheduled_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  pewawancara    Pewawancara @relation(fields: [pewawancaraId], references: [id])

  @@map("wawancara_assignment")
}

// ─── TOPSIS WEIGHTS ───────────────────────────────────────
// Bobot kriteria TOPSIS yang bisa diset admin per periode
model TopsisWeights {
  id                  BigInt   @id @default(autoincrement())
  periode             String?  // e.g. "2026-SNBP"
  penghasilanWeight   Float    @default(0.3)  @map("penghasilan_weight")
  tanggunganWeight    Float    @default(0.2)  @map("tanggungan_weight")
  jarakWeight         Float    @default(0.15) @map("jarak_weight")
  kondisiRumahWeight  Float    @default(0.15) @map("kondisi_rumah_weight")
  wawancaraWeight     Float    @default(0.2)  @map("wawancara_weight")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("topsis_weights")
}
