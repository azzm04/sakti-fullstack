generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                 @unique @map("email_sso") @db.VarChar(255)
  role                  role_enum
  statusAkun            status_akun_enum       @default(AKTIF) @map("status_akun")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  otp_tokens            OtpToken[]
  penerimaKipk          PenerimaKipk?
  pewawancara           Pewawancara?
  tokenAktivasiTelegram TokenAktivasiTelegram?

  @@map("users")
}

model AdminUser {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username    String        @unique(map: "admin_users_adminid_key") @db.VarChar(100)
  password    String        @db.VarChar(255)
  nama        String        @db.VarChar(150)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  pewawancara Pewawancara[]

  @@map("admin_users")
}

model OtpToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  users     User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("otp_tokens")
}

model TokenAktivasiTelegram {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("token_aktivasi_telegram")
}

model PenerimaKipk {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @unique @map("user_id") @db.Uuid
  nim                String
  nama               String
  prodi_id           String          @db.Uuid
  angkatan           Int             @db.SmallInt
  telegramId         BigInt?         @map("telegram_id")
  createdAt          DateTime        @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @updatedAt @map("updated_at") @db.Timestamp(6)
  hasil_wawancara_id String          @unique @db.Uuid
  hasil_wawancara    hasil_wawancara @relation(fields: [hasil_wawancara_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prodi              prodi           @relation(fields: [prodi_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("penerima_kipk")
}

model Pewawancara {
  id                   BigInt                 @id @default(autoincrement())
  totalAssigned        Int?                   @default(0) @map("total_assigned")
  totalCompleted       Int?                   @default(0) @map("total_completed")
  createdAt            DateTime?              @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?              @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @updatedAt @map("updated_at") @db.Timestamptz(6)
  adminId              String?                @map("admin_id") @db.Uuid
  userId               String?                @unique @map("user_id") @db.Uuid
  nama                 String?
  isActive             Boolean?               @default(true) @map("is_active")
  hasil_wawancara      hasil_wawancara[]
  hasil_wawancara_lama hasil_wawancara_lama[]
  kuota_pewawancara    kuota_pewawancara[]
  admin                AdminUser?             @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  slotSesi             SlotSesi[]
  wawancara_assignment wawancara_assignment[]

  @@map("pewawancara")
}

model SesiWawancara {
  id                   BigInt                 @id @default(autoincrement())
  tanggal              DateTime               @unique @db.Date
  kuotaPewawancara     Int                    @default(20) @map("kuota_pewawancara")
  kuotaMahasiswa       Int                    @default(120) @map("kuota_mahasiswa")
  warAktif             Boolean                @default(false) @map("war_aktif")
  warDibukaAt          DateTime?              @map("war_dibuka_at") @db.Timestamptz(6)
  warDitutupAt         DateTime?              @map("war_ditutup_at") @db.Timestamptz(6)
  distribusiDone       Boolean                @default(false) @map("distribusi_done")
  createdAt            DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  jalurMasuk           String?                @map("jalur_masuk")
  hasil_wawancara_lama hasil_wawancara_lama[]
  kuota_pewawancara    kuota_pewawancara[]
  slotSesi             SlotSesi[]

  @@index([tanggal], map: "idx_sesi_tanggal")
  @@map("sesi_wawancara")
}

model SlotSesi {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesiId        BigInt        @map("sesi_id")
  pewawancaraId BigInt        @map("pewawancara_id")
  slotKe        Int           @map("slot_ke") @db.SmallInt
  claimedAt     DateTime?     @map("claimed_at") @db.Timestamp(6)
  pewawancara   Pewawancara   @relation(fields: [pewawancaraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sesi          SesiWawancara @relation(fields: [sesiId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sesiId, pewawancaraId], map: "slot_sesi_sesi_pewawancara_key")
  @@unique([sesiId, slotKe], map: "slot_sesi_sesi_slot_key")
  @@map("slot_sesi")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  role      String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@map("chat_history")
}

model Aduan {
  id               String      @id @default(uuid())
  admin_id         String?     
  user_id          String?     
  kode_laporan     String      @unique @db.VarChar(20)
  jenis_aduan      JenisAduan
  nama_terlapor    String      @db.VarChar(150)
  
  // --- TAMBAHAN STANDAR FORM 2026 ---
  nim_terlapor     String?     @db.VarChar(50)  // Opsional (Jika pelapor tahu)
  fakultas_prodi   String?     @db.VarChar(150) // Wajib di form 2026
  angkatan         String?     @db.VarChar(20)  // Wajib di form 2026
  
  uraian_kronologi String      @db.Text
  url_bukti        String      @db.Text
  status           StatusAduan @default(MENUNGGU)
  created_at       DateTime    @default(now())

  @@map("aduan")
}

model BeritaInformasi {
  id             String       @id @default(uuid())
  admin_id       String
  judul          String       @db.VarChar(255)
  konten         String
  jenis          JenisBerita
  thumbnail_url  String
  status         StatusBerita @default(DRAFT)
  diterbitkan_at DateTime?
  created_at     DateTime     @default(now())

  @@map("berita_informasi")
}

model MonevSchedule {
  id                String              @id @default(cuid())
  label             String
  deadline          DateTime
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  tipeMonev         tipe_monev          @default(Evaluasi_Ekonomi) @map("tipe_monev")
  waktuMulai        DateTime?           @map("waktu_mulai") @db.Timestamptz(6)
  updatedAt         DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  monev_submissions monev_submissions[]
  notification_logs NotificationLog[]

  @@map("monev_schedules")
}

model NotificationLog {
  id              String        @id @default(cuid())
  monevScheduleId String
  triggerDay      Int
  totalSent       Int           @default(0)
  totalFailed     Int           @default(0)
  sentAt          DateTime      @default(now())
  monev_schedules MonevSchedule @relation(fields: [monevScheduleId], references: [id])

  @@map("notification_logs")
}

